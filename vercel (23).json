{
  "functions": {
    "api/ask.js": {
      "maxDuration": 60
    },
    "api/analyze.js": {
      "maxDuration": 60
    },
    "api/email.js": {
      "maxDuration": 60
    },
    "api/music.js": {
      "maxDuration": 20
    },
    "api/yt.js": {
      "maxDuration": 20
    },
    "api/admin.js": {
      "maxDuration": 60
    },
    "api/client.js": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}